generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/**
 * ===========================
 * CORE AUTH MODELS (NextAuth)
 * ===========================
 */
 //Expected data


model User {
  id        Int       @id @default(autoincrement())
  name      String?   @db.VarChar(100)
  email     String    @unique(map: "email") @db.VarChar(100)
  password  String    @db.VarChar(255)
  avatar    String?   @db.VarChar(255)
  role      UserRole  @default(STUDENT)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(0)

  // NextAuth relations
  accounts       Account[]
  sessions       Session[]
  
  // Game & Learning relations
  gameSessions   GameSession[]
  score          Score?
  progress       Progress?
  userBadges     UserBadge[]
  userAssessmentResults UserAssessmentResult[]
  analyticsEvents AnalyticsEvent[]
  
  // School system relations (for teachers/students)
  student         Student?
  teacherProfile  TeacherProfile?
  taughtStudents  Student[] @relation("TeacherStudents")
  classes         Class[]

  @@map("users")
}

model Account {
  id                Int     @id @default(autoincrement())
  userId            Int     @map("user_id")
  type              String? @db.VarChar(255)
  provider          String? @db.VarChar(255)
  providerAccountId String? @map("provider_account_id") @db.VarChar(255)
  refreshToken      String? @map("refresh_token") @db.Text
  accessToken       String? @map("access_token") @db.Text
  expiresAt         Int?    @map("expires_at")
  tokenType         String? @map("token_type") @db.VarChar(255)
  scope             String? @db.VarChar(255)
  idToken           String? @map("id_token") @db.Text
  sessionState      String? @map("session_state") @db.VarChar(255)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "account_ibfk_1")

  @@unique([provider, providerAccountId], map: "unique_provider")
  @@index([userId], map: "user_id")
  @@map("accounts")
}

model Session {
  id           Int       @id @default(autoincrement())
  sessionToken String    @unique(map: "session_token") @db.VarChar(255)
  userId       Int       @map("user_id")
  expires      DateTime  @db.DateTime(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "session_ibfk_1")

  @@index([userId], map: "user_id")
  @@map("sessions")
}

/**
 * ===========================
 * GAME & GAMIFICATION MODELS
 * ===========================
 */

model GameSession {
  id            Int       @id @default(autoincrement())
  userId        Int       @map("user_id")
  startTime     DateTime  @default(now()) @map("start_time") @db.DateTime(0)
  endTime       DateTime? @map("end_time") @db.DateTime(0)
  totalScore    Int?      @default(0) @map("total_score")
  levelReached  Int?      @default(1) @map("level_reached")
  rewardsEarned Json?     @map("rewards_earned")
  deviceType    DeviceType @default(unity) @map("device_type")
  
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade, map: "game_sessions_ibfk_1")
  analyticsEvents AnalyticsEvent[]

  @@index([userId], map: "user_id")
  @@index([startTime], map: "start_time")
  @@map("game_sessions")
}

model Score {
  id           Int       @id @default(autoincrement())
  userId       Int       @unique @map("user_id")
  totalScore   Int       @default(0) @map("total_score")
  highestScore Int       @default(0) @map("highest_score")
  xp           Int       @default(0)
  coins        Int       @default(0)
  gems         Int       @default(0)
  lastUpdated  DateTime  @updatedAt @map("last_updated") @db.DateTime(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "scores_ibfk_1")

  @@index([userId], map: "user_id")
  @@index([totalScore], map: "total_score")
  @@map("scores")
}

model UserAssessmentResult {
  id                     BigInt    @id @default(autoincrement())
  userId                 Int?      @map("user_id")
  currentScenarioId      Int       @map("current_scenario_id")
  currentDialogueNodeId  Int       @map("current_dialogue_node_id")
  points                 Int?      @default(0)
  totalScore             Int?      @default(0) @map("total_score")
  awarenessSensitivity   Int?      @default(0) @map("AwarenessSensitivity")
  empathyAndSupport      Int?      @default(0) @map("EmpathyAndSupport")
  safeResponseCapability Int?      @default(0) @map("SafeResponseCapability")
  helpSeekingTendency    Int?      @default(0) @map("HelpSeekingTendency")
  peerInterventionAbility Int?     @default(0) @map("PeerInterventionAbility")
  moralCourage           Int?      @default(0) @map("MoralCourage")
  conflictEscalationRisk Int?      @default(0) @map("ConflictEscalationRisk")
  avoidanceTendency      Int?      @default(0) @map("AvoidanceTendency")
  realName               String?   @db.VarChar(255)
  creationTimestamp      DateTime? @map("creation_timestamp") @db.Timestamp(0)
  lastUpdatedAt          DateTime? @map("last_updated_at") @db.Timestamp(0)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade, map: "user_assessment_results_ibfk_1")

  @@index([userId], map: "user_id")
  @@map("user_assessment_results")
}

model Progress {
  id               Int       @id @default(autoincrement())
  userId           Int       @unique @map("user_id")
  level            Int       @default(1)
  xp               Int       @default(0)
  completedLessons Json?     @map("completed_lessons")
  currentStreak    Int       @default(0) @map("current_streak")
  longestStreak    Int       @default(0) @map("longest_streak")
  lastPlayed       DateTime? @map("last_played") @db.DateTime(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "progress_ibfk_1")

  @@index([userId], map: "user_id")
  @@index([level], map: "level")
  @@map("progress")
}

model Badge {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  description String   @db.VarChar(255)
  icon        String?  @db.VarChar(255)
  requirement String   @db.VarChar(255)
  category    BadgeCategory
  
  userBadges  UserBadge[]

  @@map("badges")
}

model UserBadge {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  badgeId   Int      @map("badge_id")
  earnedAt  DateTime @default(now()) @map("earned_at") @db.DateTime(0)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade, map: "user_badges_ibfk_1")
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade, map: "user_badges_ibfk_2")

  @@unique([userId, badgeId], map: "unique_user_badge")
  @@index([userId], map: "user_id")
  @@index([badgeId], map: "badge_id")
  @@map("user_badges")
}

model AnalyticsEvent {
  id          Int       @id @default(autoincrement())
  userId      Int?      @map("user_id")
  sessionId   Int?      @map("session_id")
  eventType   String    @map("event_type") @db.VarChar(100)
  eventData   Json?     @map("event_data")
  timestamp   DateTime  @default(now()) @db.DateTime(0)

  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull, map: "analytics_events_ibfk_1")
  gameSession GameSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull, map: "analytics_events_ibfk_2")

  @@index([userId], map: "user_id")
  @@index([sessionId], map: "session_id")
  @@index([eventType], map: "event_type")
  @@index([timestamp], map: "timestamp")
  @@map("analytics_events")
}

/**
 * ===========================
 * SCHOOL / CLASS / STUDENT
 * ===========================
 */

model School {
  id            Int       @id @default(autoincrement())
  name          String    @db.VarChar(100)
  address       String?   @db.VarChar(255)
  contactNumber String?   @map("contact_number") @db.VarChar(20)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamp(0)

  classes         Class[]
  students        Student[]
  teacherProfiles TeacherProfile[]

  @@map("schools")
}

model Class {
  id        Int       @id @default(autoincrement())
  schoolId  Int       @map("school_id")
  className String    @map("class_name") @db.VarChar(50)
  teacherId Int?      @map("teacher_id")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(0)

  school   School    @relation(fields: [schoolId], references: [id], map: "classes_ibfk_1")
  teacher  User?     @relation(fields: [teacherId], references: [id], map: "classes_ibfk_2")
  students Student[]

  @@index([schoolId], map: "school_id")
  @@index([teacherId], map: "teacher_id")
  @@map("classes")
}

model Student {
  id        Int       @id @default(autoincrement())
  userId    Int       @unique @map("user_id")
  alias     String    @db.VarChar(100)
  classId   Int       @map("class_id")
  schoolId  Int       @map("school_id")
  teacherId Int       @map("teacher_id")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(0)

  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade, map: "students_ibfk_1")
  class   Class  @relation(fields: [classId], references: [id], map: "students_ibfk_2")
  school  School @relation(fields: [schoolId], references: [id], map: "students_ibfk_3")
  teacher User   @relation("TeacherStudents", fields: [teacherId], references: [id], map: "students_ibfk_4")

  @@index([userId], map: "user_id")
  @@index([classId], map: "class_id")
  @@index([schoolId], map: "school_id")
  @@index([teacherId], map: "teacher_id")
  @@map("students")
}

model TeacherProfile {
  id        Int     @id @default(autoincrement())
  userId    Int     @unique @map("user_id")
  subjectId Int?    @map("subject_id")
  schoolId  Int?    @map("school_id")
  name      String? @db.VarChar(255)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "teacher_profiles_ibfk_1")
  subject Subject? @relation(fields: [subjectId], references: [id], map: "teacher_profiles_ibfk_2")
  school  School?  @relation(fields: [schoolId], references: [id], map: "teacher_profiles_ibfk_3")

  @@index([userId], map: "user_id")
  @@index([subjectId], map: "subject_id")
  @@index([schoolId], map: "school_id")
  @@map("teacher_profiles")
}

model Subject {
  id      Int    @id @default(autoincrement())
  name    String @unique @db.VarChar(100)

  teachers TeacherProfile[]

  @@map("subjects")
}

/**
 * ===========================
 * ENUMS
 * ===========================
 */

enum UserRole {
  ADMIN
  TEACHER
  STUDENT
}

enum DeviceType {
  unity
  webgl
}

enum BadgeCategory {
  ACHIEVEMENT
  PROGRESS
  SPECIAL
  SOCIAL
}
